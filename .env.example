# Desenvolvimento local. Copie para .env somente quando precisar alterar valores.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000

# Endereço conhecido do CRM; não é um endpoint de API verificado.
CRM_APP_URL=https://crmoriginalli.vercel.app
# Preencher somente após confirmar o contrato da API do CRM existente.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=

# Opcional: inicialização via API em hospedagens Worker. Não é necessário no setup local.
LIFE_SETUP_KEY=
