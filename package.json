{
  "name": "originalli-site",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24.12.0 <25"},
  "scripts": {
    "dev": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:backup": "node scripts/backup-data.mjs",
    "pages:generate": "node scripts/generate-pages.mjs",
    "integrations:dispatch": "node scripts/dispatch-crm.mjs",
    "build": "node scripts/build-portal.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run doctor && npm test && npm run build"
  },
  "dependencies": {"drizzle-orm":"0.44.5","pdf-lib":"1.17.1","fflate":"0.8.2","xlsx":"https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"},
  "devDependencies": {"drizzle-kit":"0.31.4","esbuild":"0.25.10"}
}
